{
  "id": "monoschinos",
  "name": "MonosChinos",
  "version": "1.2.2",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Anime subtitulado en español de MonosChinos2 (Voe, Filemoon, StreamWish, Doodstream, MixDrop y más).",
  "author": "tu-usuario-de-github",
  "hosts": [
    "vww.monoschinos2.net",
    "*.monoschinos2.net",
    "monoschinos2.net"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "categories": [
    "anime"
  ],
  "discoverable": true,
  "debug": false,
  "color": "#FF9B05",
  "settings": [
    {
      "key": "server",
      "label": "Servidor preferido",
      "type": "select",
      "default": "mixdrop",
      "hint": "MixDrop/Mp4Upload suelen ir mejor; Filemoon y StreamWish a menudo fallan.",
      "options": [
        {
          "value": "mixdrop",
          "label": "MixDrop"
        },
        {
          "value": "mp4upload",
          "label": "Mp4Upload"
        },
        {
          "value": "uqload",
          "label": "Uqload"
        },
        {
          "value": "lulu",
          "label": "LuluStream"
        },
        {
          "value": "vidhide",
          "label": "Vidhide"
        },
        {
          "value": "voe",
          "label": "Voe"
        },
        {
          "value": "yourupload",
          "label": "YourUpload"
        },
        {
          "value": "dood",
          "label": "Doodstream"
        },
        {
          "value": "filemoon",
          "label": "Filemoon"
        },
        {
          "value": "streamwish",
          "label": "StreamWish"
        }
      ]
    }
  ]
}