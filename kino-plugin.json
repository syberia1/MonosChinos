{
  "id": "monoschinos",
  "name": "MonosChinos",
  "version": "2.2.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Anime subtitulado de monoschinos.st. Portadas, fondos y capitulos del propio sitio.",
  "author": "tu-usuario-de-github",
  "hosts": [
    "monoschinos.st",
    "www.monoschinos.st"
  ],
  "fetchHosts": "any",
  "streamHosts": "any",
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "download"
  ],
  "categories": [
    "anime"
  ],
  "discoverable": true,
  "debug": false,
  "color": "#FF9B05",
  "settings": [
    {
      "key": "server",
      "label": "Servidor preferido",
      "type": "select",
      "default": "mixdrop",
      "hint": "Se intenta primero; el resto queda en el menu Servidor.",
      "options": [
        {
          "value": "mixdrop",
          "label": "MixDrop"
        },
        {
          "value": "mp4upload",
          "label": "Mp4Upload"
        },
        {
          "value": "lulu",
          "label": "LuluStream"
        },
        {
          "value": "voe",
          "label": "Voe"
        },
        {
          "value": "savefiles",
          "label": "SaveFiles"
        },
        {
          "value": "dood",
          "label": "Doodstream"
        },
        {
          "value": "uqload",
          "label": "Uqload"
        },
        {
          "value": "hexload",
          "label": "Hexload"
        },
        {
          "value": "filemoon",
          "label": "Filemoon"
        },
        {
          "value": "streamwish",
          "label": "StreamWish"
        },
        {
          "value": "netu",
          "label": "Netu"
        }
      ]
    }
  ]
}
