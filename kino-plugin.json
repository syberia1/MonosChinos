{
  "id": "monoschinos-st",
  "name": "MonosChinos",
  "version": "1.0.0",
  "apiVersion": 8,
  "entry": "plugin.js",
  "icon": "icon.png",
  "color": "#FF6B00",
  "description": "Anime en español y subtitulado de monoschinos.st: últimos capítulos en emisión, catálogo de animes y películas con carátulas, fondos y nombres de episodios.",
  "author": "comunidad",
  "categories": ["anime", "series", "movies"],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve",
    "scopedSearch",
    "download"
  ],
  "browser": true,
  "streamHosts": "any",
  "hosts": [
    "monoschinos.st",
    "www.monoschinos.st",
    "graphql.anilist.co",
    "api.jikan.moe",
    "ok.ru",
    "www.ok.ru",
    "mp4upload.com",
    "www.mp4upload.com",
    "streamwish.to",
    "wishembed.pro",
    "sfastwish.com",
    "flaswish.com",
    "obeywish.com",
    "cdnwish.com",
    "filemoon.sx",
    "filemoon.to",
    "voe.sx",
    "uqload.to",
    "uqload.net",
    "uqload.co",
    "yourupload.com",
    "www.yourupload.com",
    "streamtape.com",
    "streamtape.to",
    "dood.li",
    "dood.wf",
    "d000d.com",
    "mixdrop.ag",
    "mixdrop.co",
    "fireload.com"
  ],
  "section": {
    "label": "MonosChinos"
  },
  "theme": {
    "accent": "#FF6B00",
    "onAccent": "#FFFFFF",
    "background": "#0F1016",
    "surface": "#181A24",
    "highlight": "#FF8C3B"
  },
  "settings": [
    {
      "key": "preferredServer",
      "label": "Servidor preferido",
      "type": "select",
      "hint": "Elige qué servidor abrir primero al reproducir un capítulo",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automático (Recomendado)" },
        { "value": "streamwish", "label": "StreamWish" },
        { "value": "filemoon", "label": "Filemoon" },
        { "value": "voe", "label": "VOE" },
        { "value": "mp4upload", "label": "Mp4Upload" },
        { "value": "okru", "label": "OK.ru" },
        { "value": "uqload", "label": "Uqload" },
        { "value": "yourupload", "label": "YourUpload" },
        { "value": "streamtape", "label": "Streamtape" }
      ]
    },
    {
      "key": "enrichMeta",
      "label": "Enriquecer portadas y episodios",
      "type": "toggle",
      "hint": "Busca fondos, sinopsis y nombres de capítulos en TMDB, AniList y MAL",
      "default": true
    }
  ]
}